{
  "name": "little-legion-web",
  "private": true,
  "version": "0.1.0",
  "description": "Little Legion desktop client (three.js) with cross-play against the Quest build.",
  "type": "module",
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "node scripts/protocol-fixture.mjs && FRONTIER_E2E=1 vitest run",
    "pretest": "node scripts/protocol-fixture.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
