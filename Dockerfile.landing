# Standalone marketing site; no Unity build or backend required.
FROM nginx:1.27-alpine
COPY landing/ /usr/share/nginx/html/landing/
COPY hosting/landing/nginx.conf /etc/nginx/conf.d/default.conf
COPY hosting/landing/40-landing-url.sh /docker-entrypoint.d/40-landing-url.sh
RUN cp /usr/share/nginx/html/landing/index.html /opt/landing-index.html \
    && chmod +x /docker-entrypoint.d/40-landing-url.sh
ENV LANDING_URL=https://littlelegion.app/landing/
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
